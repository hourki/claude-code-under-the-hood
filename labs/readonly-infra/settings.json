{
  "permissions": {
    "deny": [
      "Edit",
      "Write",
      "NotebookEdit",
      "Bash(kubectl apply *)",
      "Bash(kubectl create *)",
      "Bash(kubectl delete *)",
      "Bash(kubectl edit *)",
      "Bash(kubectl patch *)",
      "Bash(kubectl scale *)",
      "Bash(terraform apply *)",
      "Bash(terraform destroy *)",
      "Bash(helm install *)",
      "Bash(helm upgrade *)",
      "Bash(helm uninstall *)",
      "Bash(aws s3 rm *)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "node", "args": ["<path-to-repo>/labs/readonly-infra/dist/block-writes.js"], "onFailure": "block" }]
      }
    ]
  }
}
